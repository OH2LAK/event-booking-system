# Control plane (platform/) settings. Copy to .env, fill in, never commit.
PORT=8080
DATABASE_URL=postgres://platform:CHANGE_ME@localhost:5432/platform
PG_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres
TENANT_DB_HOST=ebs-postgres
BASE_DOMAIN=hamradio-events.com
PLATFORM_PUBLIC_URL=https://platform.hamradio-events.com
ALLOWED_ORIGINS=https://hamradio-events.com,https://www.hamradio-events.com
OPERATOR_PASSWORD=CHANGE_ME_LONG_RANDOM
SESSION_SECRET=CHANGE_ME_LONG_RANDOM
OPERATOR_EMAIL=you@example.com
# Price per event in cents (the owner decides; 0 = free, no payment step)
EVENT_PRICE_CENTS=0
EVENT_CURRENCY=eur
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=0
RETENTION_DAYS=30
WARN_DAYS=7
RUNNER=docker
APP_IMAGE=ghcr.io/oh2lak/event-booking-system:latest
DOCKER_NETWORK=ebs-net
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Hamradio Events <noreply@hamradio-events.com>
