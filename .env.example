# Copy to .env and fill in. Never commit .env.

# --- App ---
PORT=3000
# Time zone used for the registration deadline (23:59 on the closing date) and timestamps
TZ=Europe/Helsinki
NODE_ENV=production
# Public URL of the booking site (used in emails and join links)
PUBLIC_URL=https://booking.example.org

# --- Database (used by docker-compose and the app) ---
POSTGRES_DB=vushf
POSTGRES_USER=vushf
POSTGRES_PASSWORD=change-me-db-password
# DATABASE_URL is built automatically by docker-compose from the POSTGRES_* values.
# Only set it yourself when running the app outside Docker, e.g.:
# DATABASE_URL=postgres://vushf:change-me-db-password@localhost:5432/vushf

# --- Admin ---
# DEFAULTS BELOW ARE PUBLIC KNOWLEDGE - CHANGE ALL OF THEM before exposing the app to the internet.
# The app logs a loud warning at startup while any default value is still in use.
ADMIN_PASSWORD=change-me-admin-password
# Long random string for signing admin session cookies (e.g. openssl rand -hex 32)
SESSION_SECRET=change-me-session-secret-use-openssl-rand-hex-32

# --- Email (SMTP) ---
# Leave SMTP_HOST empty to disable email sending (emails are then only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=change-me-smtp-password
EMAIL_SENDER_NAME=
EMAIL_FROM=
# Reply-To and organizer notification address
REPLY_TO_EMAIL=
