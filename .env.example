# Copy to .env and fill in. Never commit .env.

# --- App ---
PORT=3000
# Time zone used for the registration deadline (23:59 on the closing date) and timestamps
TZ=Europe/Helsinki
NODE_ENV=production
# Public URL of the booking site (used in emails and join links)
PUBLIC_URL=https://booking.example.org

# --- Database (used by docker-compose and the app) ---
POSTGRES_DB=vushf
POSTGRES_USER=vushf
POSTGRES_PASSWORD=change-me-db-password
# DATABASE_URL is built automatically by docker-compose from the POSTGRES_* values.
# Only set it yourself when running the app outside Docker, e.g.:
# DATABASE_URL=postgres://vushf:change-me-db-password@localhost:5432/vushf

# --- Admin ---
# DEFAULTS BELOW ARE PUBLIC KNOWLEDGE - CHANGE ALL OF THEM before exposing the app to the internet.
# The app logs a loud warning at startup while any default value is still in use.
# Admin accounts: every admin has a named account with a password and a required second factor (see docs/ADMIN-GUIDE.md).
# SETUP_PASSWORD is only the first-time setup code: on a fresh system it lets you create the first Event setup account at /?setup=1.
# After that it opens nothing. If it is empty or a change-me placeholder, a random code is printed in the server log at startup.
SETUP_PASSWORD=change-me-setup-password
# ADMIN_PASSWORD is not used any more (kept only as a fallback for the setup code when SETUP_PASSWORD is empty)
ADMIN_PASSWORD=
# Optional: fix the email address of the first account
# OWNER_EMAIL=
# Used to derive the key that encrypts authenticator-app secrets (e.g. openssl rand -hex 32). Changing it later requires resetting 2FA.
SESSION_SECRET=change-me-session-secret-use-openssl-rand-hex-32

# --- Email (SMTP) ---
# Leave SMTP_HOST empty to disable email sending (emails are then only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=change-me-smtp-password
EMAIL_SENDER_NAME=
EMAIL_FROM=
# Reply-To and organizer notification address
REPLY_TO_EMAIL=

# --- SMS (optional; off unless all three are set) ---
# Booking confirmations are sent by SMS when the guest gave a phone number.
# SMS_GATEWAY_URL is the full URL of the gateway's send endpoint (check the path with your provider).
# SMS_SENDER_ID: alphanumeric sender shown to the recipient, at most 11 characters (letters/digits/space), approved by the provider.
SMS_GATEWAY_URL=
SMS_API_TOKEN=
SMS_SENDER_ID=HamEvents
# Numbers typed with a leading 0 get this country code (358 = Finland); numbers without 0 or + or 00 are not sent
SMS_DEFAULT_COUNTRY_CODE=358
# Safety cap: messages per instance (0 = no cap)
SMS_MAX_PER_INSTANCE=300

# Failed sign-in attempts per address per 15 minutes before blocking (default 10)
# AUTH_IP_FAILURES=10

# --- Public API (optional; switched on in Event setup, see docs/API.md) ---
# Requests per minute allowed per API key (default 300)
# API_RATE_PER_MINUTE=300
# Webhooks may only call public https addresses. Set to 1 to allow http:// and private/local network receivers (private installations only).
# API_WEBHOOK_ALLOW_PRIVATE=0
