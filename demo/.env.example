# Settings for the public demo (see demo/README.md). Copy to .env in this folder.

# The demo passwords are PUBLIC: they are shown in the demo banner and on the website. Do not reuse real passwords.
ADMIN_PASSWORD=demo-admin
SETUP_PASSWORD=demo-setup

# These two are secret. Generate them with:  openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-random
SESSION_SECRET=replace-with-random-at-least-32-characters

# Public address of the demo (used in links the app builds)
PUBLIC_URL=https://demo.hamradio-events.com

# Token of the Cloudflare Tunnel (Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels). Secret.
TUNNEL_TOKEN=

# Time zone for the nightly reset
TZ=Europe/Helsinki

# Optional tuning (defaults shown)
#DEMO_RESET_HOUR=3          # nightly reset at this hour, 0-23
#DEMO_IDLE_MINUTES=30       # reset when changed and nobody has used it for this long
#DEMO_MAX_DIRTY_HOURS=6     # reset at the latest this long after the first change
#DEMO_MAX_BOOKINGS=200      # stop accepting bookings above this number
